{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "椰果工具箱",
    "version": "0.0.5",
    "identifier": "com.northshore416.afyg.combotrainer",
    "build": {
        "beforeDevCommand": "npm.cmd run dev",
        "devUrl": "http://127.0.0.1:5174",
        "beforeBuildCommand": "npm.cmd run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "椰果工具箱",
                "width": 1280,
                "height": 820,
                "minWidth": 1080,
                "minHeight": 680,
                "resizable": true,
                "center": true
            },
            {
                "label": "overlay",
                "title": "Combo Overlay",
                "url": "overlay.html",
                "width": 980,
                "height": 118,
                "x": 160,
                "y": 36,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "resizable": true,
                "visible": false
            },
            {
                "label": "rhythm-feedback",
                "title": "Rhythm Feedback",
                "url": "rhythm-feedback.html",
                "width": 260,
                "height": 96,
                "x": 520,
                "y": 320,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "resizable": true,
                "visible": false
            },
            {
                "label": "key-mapping",
                "title": "Key Mapping Overlay",
                "url": "key-mapping.html",
                "width": 620,
                "height": 514,
                "x": 520,
                "y": 220,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "resizable": true,
                "visible": false
            },
            {
                "label": "recording-indicator",
                "title": "Recording Status",
                "url": "recording-indicator.html",
                "width": 48,
                "height": 48,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "resizable": false,
                "visible": false
            }
        ],
        "security": {
            "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https://ygkit.usotsuki-kaze.com https://wuwa-hpyg-tool.200503.xyz https://nova.fb520.site https://api.github.com; img-src 'self' asset: http://asset.localhost blob: data: https:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-src 'none'",
            "assetProtocol": {
                "enable": true,
                "scope": []
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.ico"
        ],
        "resources": [],
        "windows": {
            "wix": {
                "language": "zh-CN"
            },
            "nsis": {
                "languages": [
                    "SimpChinese"
                ]
            }
        }
    }
}
