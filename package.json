{
    "name": "wuwa-afyg-tool",
    "private": true,
    "version": "0.0.5",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "download-icons": "node scripts/download-static-icons.mjs",
        "generate-mdi-icons": "node scripts/generate-mdi-icons.mjs",
        "generate-icons": "node scripts/generate-icons.mjs",
        "server:build": "pnpm run build",
        "server:start": "cross-env HOST=127.0.0.1 PORT=39818 node build-server/index.js",
        "trainer:dev": "pnpm --filter @northshore/afyg-combo-trainer dev",
        "trainer:check": "pnpm --filter @northshore/afyg-combo-trainer typecheck",
        "trainer:build": "pnpm --filter @northshore/afyg-combo-trainer build",
        "trainer:desktop:dev": "pnpm --filter @northshore/afyg-combo-trainer tauri:dev",
        "trainer:desktop:build": "pnpm --filter @northshore/afyg-combo-trainer tauri:build",
        "trainer:desktop:build:full": "pnpm --filter @northshore/afyg-combo-trainer tauri:build:full",
        "shared:check": "pnpm --filter @northshore/desktop-protocol typecheck && pnpm --filter @northshore/desktop-api-client typecheck",
        "desktop:check": "pnpm run shared:check && pnpm run check && pnpm run trainer:check"
    },
    "devDependencies": {
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/svelte": "^5.2.2",
        "@resvg/resvg-js": "^2.6.2",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^24.0.0",
        "@types/prismjs": "^1.26.6",
        "@vite-pwa/sveltekit": "^1.1.0",
        "cross-env": "^10.0.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "better-sqlite3": "^12.0.0",
        "chart.js": "^4.5.1",
        "prismjs": "^1.30.0",
        "@northshore/desktop-protocol": "workspace:*"
    }
}
