{
    "name": "wuwa-afyg-tool",
    "private": true,
    "version": "0.0.4",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "generate-icons": "node scripts/generate-icons.mjs",
        "desktop:dev": "node scripts/desktop-dev.mjs",
        "desktop:build": "cross-env DEPLOY_TARGET=desktop node scripts/run-pnpm.mjs run build && electron-builder",
        "server:build": "cross-env DEPLOY_TARGET=server pnpm run build",
        "server:start": "cross-env HOST=127.0.0.1 PORT=39818 node build-server/index.js"
    },
    "devDependencies": {
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/svelte": "^5.2.2",
        "@resvg/resvg-js": "^2.6.2",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/adapter-vercel": "^6.3.3",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^24.0.0",
        "@types/prismjs": "^1.26.6",
        "@vite-pwa/sveltekit": "^1.1.0",
        "concurrently": "^9.0.0",
        "cross-env": "^10.0.0",
        "electron": "^39.0.0",
        "electron-builder": "^26.0.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "wait-on": "^9.0.0"
    },
    "dependencies": {
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "better-sqlite3": "^12.0.0",
        "chart.js": "^4.5.1",
        "prismjs": "^1.30.0"
    },
    "main": "electron/main.cjs",
    "build": {
        "appId": "cc.wuwa.afyg.tool",
        "productName": "WUWA AFYG Tool",
        "directories": {
            "output": "release"
        },
        "files": [
            "build/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "WUWA AFYG Tool"
        }
    }
}
